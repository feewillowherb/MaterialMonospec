# AI pipelines — secrets and immutable run evidence
pipelines/**/secrets.local.yaml
pipelines/**/secrets.local.*
pipelines/**/runs/
!pipelines/**/runs/.gitkeep


# Local machine-only secrets (never commit). Contract: .local/AGENTS.md
#   .local/.ssh/docker-linux-ed25519   (user-supplied; replace yourself)
# Ignore contents, not the directory, so AGENTS.md can be tracked.
.local/*
!.local/AGENTS.md
